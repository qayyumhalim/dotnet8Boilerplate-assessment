@page "{id:int}"
@model AcmePortal.Pages.TransactionPages.EditModel

@{
    ViewData["Title"] = "Edit Transaction";
}

<h4>Edit Transaction</h4>

<div class="card" style="max-width:600px;">
    <div class="card-body">

        <form method="post">

            <input type="hidden" asp-for="Transaction.Id" />

            <div asp-validation-summary="All"
                 class="text-danger mb-3">
            </div>

            <div class="mb-3">
                <label class="form-label">Customer</label>

                <select asp-for="Transaction.CustomerId"
                        class="form-select">

                    @foreach (var customer in Model.Customers)
                    {
                        <option value="@customer.Id">
                            @customer.Name
                        </option>
                    }

                </select>
            </div>

            <div class="mb-3">
                <label class="form-label">Product</label>

                <select asp-for="Transaction.ProductId"
                        class="form-select">

                    @foreach (var product in Model.Products)
                    {
                        <option value="@product.Id">
                            @product.Name
                            (Stock: @product.Quantity)
                        </option>
                    }

                </select>
            </div>

            <div class="mb-3">
                <label asp-for="Transaction.Quantity"
                       class="form-label">
                </label>

                <input asp-for="Transaction.Quantity"
                       class="form-control" />

                <span asp-validation-for="Transaction.Quantity"
                      class="text-danger">
                </span>
            </div>

            <button type="submit"
                    class="btn btn-primary">

                Update

            </button>

            <a asp-page="./Index"
               class="btn btn-secondary ms-2">

                Cancel

            </a>

        </form>

    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}