@page
@model AcmePortal.Pages.TransactionPages.IndexModel

@{
    ViewData["Title"] = "Transactions";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h4>Transactions</h4>
    @if (User.IsInRole(AppRoles.Admin))
    {
        <a asp-page="Create" class="btn btn-primary">Create New</a>
    }
</div>
<table id="table" class="table table-striped table-hover">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Transaction[0].ReferenceNo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Transaction[0].PurchaseDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Transaction[0].Customer)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Transaction[0].Product)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Transaction[0].Quantity)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Transaction[0].TotalPrice)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Transaction[0].CreatedAt)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.Transaction)
        {
            <tr>
                <td>
                    @Html.DisplayFor(model => item.ReferenceNo)
                </td>
                <td>
                    @Html.DisplayFor(model => item.PurchaseDate)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Customer)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Product)
                </td>
                <td>
                    @Html.DisplayFor(model => item.Quantity)
                </td>
                <td>
                    @Html.DisplayFor(model => item.TotalPrice)
                </td>
                <td>
                    @Html.DisplayFor(model => item.CreatedAt)
                </td>
                <td>
                    @if (User.IsInRole(AppRoles.Admin))
                    {
                        <a asp-page="./Edit" asp-route-id="@item.Id" class="btn btn-sm btn-primary">Edit</a>
                        <a asp-page="./Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger ms-1">Delete</a>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>

@section Scripts {
    <script>$('#table').DataTable();</script>
}
